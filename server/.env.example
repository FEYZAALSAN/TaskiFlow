# Mailtrap'te Password yanindaki Show ile kopyalayin
SMTP_PASS=BURAYA_MAILTRAP_SIFRESI
SMTP_FROM="TaskiFlow <noreply@taskiflow.com>"
# Sifre sifirlama linkinin acilacagi sayfa
PASSWORD_RESET_URL=http://localhost:3000/reset-password
